#!/usr/bin/env bash
# Checks that every secret really is encrypted to the machines
# agenix-rules.nix names for it. Reads lines "<file.age> <ssh-ed25519 key>"
# on stdin, one per machine and secret.
#
# age marks each SSH recipient in the file's header with a tag: the first
# four bytes of the SHA-256 of the public key, in base64. A machine listed
# in the rules whose tag is missing cannot decrypt the secret, and its
# activation would fail: re-encrypt with `agenix -r -i identity.age`.
set -euo pipefail

missing=0
while read -r file key; do
  hash=$(printf '%s' "$key" | base64 -d | sha256sum | cut -c1-8)
  tag=$(printf '%b' "\\x${hash:0:2}\\x${hash:2:2}\\x${hash:4:2}\\x${hash:6:2}" | base64 | tr -d '=')
  if ! grep -aqF -- "-> ssh-ed25519 $tag " "$file"; then
    echo "$(basename "$file") is not encrypted to ssh-ed25519 ${key:0:20}... (run agenix -r)" >&2
    missing=1
  fi
done

exit "$missing"
