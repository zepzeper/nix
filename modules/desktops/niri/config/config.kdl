// niri config for my workstation (niri 26.04). Docs:
// https://niri-wm.github.io/niri/
//
// Split by subject; this file holds the general settings and includes the
// rest. Managed from the repo (modules/desktops/niri/config/) and checked
// with `niri validate` when the system is built.
//
// Includes are positional: a later file overrides an earlier one.
//
//   input.kdl      keyboard, touchpad, mouse
//   layout.kdl     layout, borders, shadows, blur
//   rules.kdl      window and layer rules
//   binds.kdl      keybindings
//   outputs.kdl    this machine's monitors - generated from
//                  zep.niri.options.outputs in its host file
//   noctalia.kdl   colours from Noctalia's theme - written by Noctalia
//   local.kdl      ~/.config/niri/local.kdl - live experiments, not in the
//                  repo; overrides everything and reloads on save

// Apps draw no titlebars; niri's border shows focus instead.
prefer-no-csd

// Noctalia draws its own hotkey hints; skip niri's popup at login.
hotkey-overlay {
    skip-at-startup
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    off
}

debug {
    // Lets Noctalia's notifications focus the app that sent them.
    honor-xdg-activation-with-invalid-serial
}

include "input.kdl"
include "layout.kdl"
include "rules.kdl"
include "binds.kdl"
include "outputs.kdl"
include optional=true "noctalia.kdl"
include optional=true "~/.config/niri/local.kdl"
