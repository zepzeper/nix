#!/usr/bin/env bash
# Deploys Kodai on this server. From the desktop (-t: sudo asks my password):
#
#   ssh -t <server> kodai-deploy <branch, tag or commit>
#   ssh -t <server> kodai-deploy --key    the deploy key, to add on GitHub once
#
# Fetches the code into /srv/kodai (cloning it the first time, with the
# server's own read-only deploy key), installs the PHP dependencies without
# the development ones, runs the database migrations, then reloads PHP-FPM
# and restarts the workers and the scheduler. Everything runs as the kodai
# user; sudo is only for the reload and the restarts.
set -euo pipefail

dir=/srv/kodai
repo=git@github.com:zepzeper/kodai.git
key=/var/lib/kodai/.ssh/id_ed25519

# Everything as kodai, which owns /srv/kodai and its home (I cannot even look
# inside either). sudo resets PATH; keep ours (git, php, composer come from
# this script's). in_app runs in the checkout.
as_kodai() { sudo -u kodai -H env "PATH=$PATH" "$@"; }
in_app() { sudo -u kodai -H env -C "$dir" "PATH=$PATH" "$@"; }

ref="${1:?usage: kodai-deploy <branch|tag|commit>, or kodai-deploy --key}"

if ! as_kodai test -f "$key"; then
    as_kodai mkdir -p -m 700 "$(dirname "$key")"
    as_kodai ssh-keygen -q -t ed25519 -N "" -C "kodai-deploy@$(cat /proc/sys/kernel/hostname)" -f "$key"
fi

if [[ "$ref" == --key ]]; then
    echo "Add this on GitHub: zepzeper/kodai -> Settings -> Deploy keys (read-only):"
    echo
    sudo cat "$key.pub"
    exit 0
fi

if [[ ! -f /run/agenix/kodai-env ]]; then
    echo "No environment yet: secrets/kodai-env.age for this server (see modules/services/kodai/kodai.md)." >&2
    exit 1
fi

if ! as_kodai test -d "$dir/.git"; then
    as_kodai git clone --quiet "$repo" "$dir"
fi

# --force: a tag that was moved on GitHub moves here too.
in_app git fetch --quiet --prune --tags --force origin
# A branch deploys what is on GitHub now; a tag or commit as it is.
if in_app git rev-parse --verify --quiet "origin/$ref" >/dev/null; then
    in_app git checkout --quiet --force --detach "origin/$ref"
else
    in_app git checkout --quiet --force --detach "$ref"
fi

in_app ln -sfn /run/agenix/kodai-env .env

in_app composer install --quiet --no-interaction --prefer-dist --no-dev --classmap-authoritative
in_app vendor/bin/phinx migrate
in_app php bin/kodai cache:clear

sudo systemctl reload phpfpm-kodai.service
sudo systemctl restart kodai-scheduler.service 'kodai-worker-*.service'

echo "Deployed $ref ($(in_app git rev-parse --short HEAD))."
