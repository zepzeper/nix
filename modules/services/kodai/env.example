# Kodai's .env on a server. Its real content is a secret
# (secrets/kodai-env.age): copy this into it with `agenix -e kodai-env.age`
# and fill in the two marked lines. The deploy links it to /srv/kodai/.env.

APP_ENV=prod
APP_DEBUG=false
# The address it is reached at: the server's name in the tailnet.
APP_URL=http://CHANGE-ME.your-tailnet.ts.net
# A new key per server: echo "base64:$(openssl rand -base64 32)"
APP_KEY=CHANGE-ME
APP_TIMEZONE=Europe/Amsterdam

# MariaDB on this server, over its socket: the kodai system user is the kodai
# database user, no password.
DB_DRIVER=mysql
DB_HOST=localhost
DB_DATABASE=kodai
DB_USERNAME=kodai
DB_PASSWORD=

# Caught by Mailpit on this server, nothing is delivered: read it at
# http://<server>:8025 over the tailnet.
MAIL_DSN=smtp://127.0.0.1:1025
MAIL_FROM_ADDRESS=kodai@localhost
MAIL_FROM_NAME=Kodai
MAIL_REPLY_TO=

QUEUE_DRIVER=database
CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

API_HOST=
