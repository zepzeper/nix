#!/usr/bin/env bash
# Succeeds when the flake (e.g. github:zepzeper/nix) has a commit the running
# system was not built from, so the automatic update only builds when there
# is something new. Any failure (no network, GitHub down) counts as "nothing
# new": the next run tries again.
#
# A commit that was tried and did not end up running (it fails to build, or
# the build hit a network hiccup) is tried again after an hour, not on every
# run. To try it right away, remove the state file and start
# nixos-upgrade.service.
set -euo pipefail

flake="${1:?usage: update-available <flake> <state-file>}"
state="${2:?usage: update-available <flake> <state-file>}"
retry_minutes=60

latest="$(nix --extra-experimental-features 'nix-command flakes' flake metadata --refresh --json "$flake" | jq -r '.revision // empty')"
running="$(/run/current-system/sw/bin/nixos-version --configuration-revision 2>/dev/null || true)"
tried="$(cat "$state" 2>/dev/null || true)"

[[ -n "$latest" && "$latest" != "$running" ]] || exit 1

if [[ "$latest" == "$tried" && -n "$(find "$state" -mmin "-$retry_minutes")" ]]; then
  exit 1
fi

echo "$latest" > "$state"
echo "updating to $latest"
