#!/usr/bin/env bash
# Lets the TPM (the laptop's security chip) unlock the encrypted disk at
# boot, after a short PIN, instead of the long passphrase. Run once after the
# install, with the colleague there to choose the PIN:
#
#   enroll-tpm-pin
#
# It asks for the disk passphrase (or the recovery key) first, then the new
# PIN twice. Running it again replaces the PIN. The passphrase and the
# recovery key keep working, so keep them in the password manager.
#
# The key is sealed in this laptop's TPM and opens only with the PIN; the
# TPM locks itself after repeated wrong PINs. It is deliberately not tied to
# boot measurements (PCRs): those change with firmware and boot updates,
# which would make the PIN stop working after an update. So nothing has to
# be enrolled again after updates. The disk stays useless outside this
# laptop, and without the PIN inside it.
set -euo pipefail

device=/dev/disk/by-partlabel/disk-main-root

sudo systemd-cryptenroll --wipe-slot=tpm2 \
    --tpm2-device=auto --tpm2-with-pin=yes --tpm2-pcrs= \
    "$device"

echo "Done: from the next boot the disk asks for the PIN."
