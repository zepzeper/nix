#!/usr/bin/env bash
# One-time move of secrets from the zepzeper/dev repository into this folder,
# re-encrypted for agenix: to me and to this machine. Run it on the machine,
# from anywhere:
#
#   secrets/import-from-dev ~/personal/dev
#
# It asks for the age passphrase (Bitwarden) once. Plaintext only ever lives
# in a tmpfs and is removed on exit. Afterwards: git add, commit, push, switch.
set -euo pipefail

# age comes with the dev tools; before the first switch with them, borrow it.
command -v age >/dev/null || exec nix shell nixpkgs#age -c "$0" "$@"

here="$(cd "$(dirname "$0")" && pwd)"
dev="${1:?usage: import-from-dev <path to the dev repository>}"
host="$(cat /proc/sys/kernel/hostname)"

[[ -f "$dev/secrets/identity.age" ]] || {
    echo "no $dev/secrets/identity.age - is that the dev repository?" >&2
    exit 1
}

# This machine's SSH host key: what it decrypts its secrets with at boot.
if [[ ! -f "$here/hosts/$host.pub" ]]; then
    cp /etc/ssh/ssh_host_ed25519_key.pub "$here/hosts/$host.pub"
    echo "added hosts/$host.pub"
fi

# My age key, still locked with the passphrase: `agenix -e` uses it later.
cp "$dev/secrets/identity.age" "$here/identity.age"

tmp="$(mktemp -d "${XDG_RUNTIME_DIR:-/dev/shm}/import-secrets.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT INT TERM

echo "age passphrase for the identity:"
age --decrypt --output "$tmp/identity" "$dev/secrets/identity.age"

recipients=(
    --recipient "$(cat "$here/recipients/zepzeper.txt")"
    --recipient "$(cat "$here/hosts/$host.pub")"
)

# Decrypt to the tmpfs first: a secret that fails to decrypt then writes
# nothing here (piped, it would leave an empty but valid-looking secret).
# One failing does not stop the others; running this again is safe.
failed=()
for name in tailscale-authkey intelephense ansible-vault; do
    if age --decrypt --identity "$tmp/identity" --output "$tmp/$name" "$dev/secrets/store/$name.age"; then
        age --encrypt "${recipients[@]}" --output "$here/$name.age" "$tmp/$name"
        echo "imported $name"
    else
        failed+=("$name")
        echo "FAILED  $name (secrets/store/$name.age in the dev repository)" >&2
    fi
done

if ((${#failed[@]})); then
    echo
    echo "not imported: ${failed[*]}. The others are done; fix those and run this again." >&2
    exit 1
fi

echo
echo "done. Next: git add secrets && git commit && git push && nh os switch"
echo "(flakes only see files git knows about: without git add, nothing uses them)"
